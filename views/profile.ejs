<%- layout('/layouts/boilerplate') %>
<style>
  .rr-profile-page {
    min-height: calc(100vh - 66px);
    background: var(--off-white);
    padding: 48px 0 80px;
  }
  [data-theme="dark"] .rr-profile-page { background: #0f1624; }

  .rr-profile { max-width: 960px; margin: 0 auto; padding: 0 24px; }

  /* ── Hero ── */
  .rr-profile-hero {
    border-radius: 24px; padding: 40px 44px; margin-bottom: 32px;
    display: flex; align-items: center; gap: 32px;
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, var(--navy) 0%, #243044 100%);
    color: #fff;
  }
  [data-theme="dark"] .rr-profile-hero {
    background: linear-gradient(135deg, rgba(79,110,242,0.18) 0%, rgba(139,92,246,0.12) 100%);
    border: 1px solid rgba(79,110,242,0.2);
    box-shadow: 0 4px 40px rgba(79,110,242,0.12);
  }
  .rr-profile-hero::before {
    content: '';
    position: absolute; top: -60px; right: -60px;
    width: 240px; height: 240px; border-radius: 50%;
    background: rgba(201,168,76,0.07); pointer-events: none;
  }
  .rr-profile-hero::after {
    content: '';
    position: absolute; bottom: -40px; left: -20px;
    width: 160px; height: 160px; border-radius: 50%;
    background: rgba(255,255,255,0.03); pointer-events: none;
  }

  .rr-profile-avatar {
    width: 96px; height: 96px; border-radius: 50%;
    background: rgba(201,168,76,0.18); border: 3px solid var(--gold);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.4rem; color: var(--gold); flex-shrink: 0; font-weight: 800;
    position: relative; z-index: 1;
  }
  [data-theme="dark"] .rr-profile-avatar {
    background: rgba(79,110,242,0.2); border-color: #4f6ef2; color: #93c5fd;
  }

  .rr-profile-hero-info { position: relative; z-index: 1; }
  .rr-profile-hero-info h1 { font-size: 1.8rem; color: #fff; margin: 0 0 4px; font-weight: 800; }
  .rr-profile-hero-info p { color: rgba(255,255,255,0.6); font-size: 0.9rem; margin: 0 0 12px; }

  .rr-profile-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(201,168,76,0.18); border: 1px solid rgba(201,168,76,0.35);
    color: var(--gold); padding: 5px 14px; border-radius: 20px;
    font-size: 0.78rem; font-weight: 700;
  }
  [data-theme="dark"] .rr-profile-badge {
    background: rgba(79,110,242,0.18); border-color: rgba(79,110,242,0.3); color: #93c5fd;
  }

  /* ── Grid ── */
  .rr-profile-grid {
    display: grid; grid-template-columns: 1fr 300px; gap: 24px;
  }

  /* ── Card ── */
  .rr-pcard {
    background: var(--white); border-radius: 18px;
    border: 1px solid var(--gray-200);
    padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  [data-theme="dark"] .rr-pcard {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.07);
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    backdrop-filter: blur(10px);
  }
  .rr-pcard-title {
    font-size: 0.78rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.8px; color: var(--gray-500);
    margin-bottom: 18px; display: flex; align-items: center; gap: 8px;
  }
  [data-theme="dark"] .rr-pcard-title { color: #4f6ef2; }
  .rr-pcard-title i { font-size: 0.9rem; }

  /* ── Detail rows ── */
  .rr-detail-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 0; border-bottom: 1px solid var(--gray-200);
  }
  [data-theme="dark"] .rr-detail-row { border-color: rgba(255,255,255,0.06); }
  .rr-detail-row:last-child { border-bottom: none; padding-bottom: 0; }
  .rr-detail-label { font-size: 0.85rem; color: var(--gray-500); font-weight: 500; }
  [data-theme="dark"] .rr-detail-label { color: #64748b; }
  .rr-detail-value { font-size: 0.93rem; font-weight: 600; color: var(--navy); }
  [data-theme="dark"] .rr-detail-value { color: #e2e8f0; }

  /* ── Stats ── */
  .rr-stats-row { display: grid; grid-template-columns: repeat(3, 1fr); }
  .rr-stat {
    text-align: center; padding: 20px 8px;
    border-right: 1px solid var(--gray-200);
  }
  [data-theme="dark"] .rr-stat { border-color: rgba(255,255,255,0.06); }
  .rr-stat:last-child { border-right: none; }
  .rr-stat-num {
    font-size: 1.8rem; font-weight: 800; color: var(--navy);
    line-height: 1; margin-bottom: 4px;
  }
  [data-theme="dark"] .rr-stat-num { color: #4f6ef2; }
  .rr-stat-label { font-size: 0.75rem; color: var(--gray-500); font-weight: 500; }
  [data-theme="dark"] .rr-stat-label { color: #64748b; }

  /* ── Action buttons ── */
  .rr-action-btn {
    display: flex; align-items: center; gap: 10px;
    padding: 11px 16px; border-radius: 12px;
    font-size: 0.9rem; font-weight: 600; text-decoration: none;
    border: 1.5px solid var(--gray-200);
    color: var(--gray-800); background: var(--white);
    transition: all 0.2s ease; width: 100%; cursor: pointer;
    font-family: inherit;
  }
  [data-theme="dark"] .rr-action-btn {
    border-color: rgba(255,255,255,0.09); color: #cbd5e1;
    background: rgba(255,255,255,0.04);
  }
  .rr-action-btn:hover {
    border-color: var(--navy); color: var(--navy);
    background: var(--gray-50); transform: translateX(3px);
  }
  [data-theme="dark"] .rr-action-btn:hover {
    border-color: #4f6ef2; color: #93c5fd;
    background: rgba(79,110,242,0.08);
  }
  .rr-action-btn.danger { color: var(--red); }
  [data-theme="dark"] .rr-action-btn.danger { color: #fca5a5; border-color: rgba(220,53,69,0.2); }
  .rr-action-btn.danger:hover { border-color: var(--red); background: #fee2e2; transform: translateX(3px); }
  [data-theme="dark"] .rr-action-btn.danger:hover { background: rgba(220,53,69,0.12); border-color: rgba(220,53,69,0.4); }
  .rr-action-btn i { width: 18px; flex-shrink: 0; }

  /* ── Security card ── */
  .rr-security-card {
    background: linear-gradient(135deg, rgba(201,168,76,0.06) 0%, rgba(201,168,76,0.02) 100%);
    border: 1px solid rgba(201,168,76,0.2);
    border-radius: 14px; padding: 18px;
    display: flex; gap: 12px; align-items: flex-start;
    margin-top: 8px;
  }
  [data-theme="dark"] .rr-security-card {
    background: rgba(79,110,242,0.06);
    border-color: rgba(79,110,242,0.15);
  }
  .rr-security-icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: rgba(201,168,76,0.15); display: flex; align-items: center; justify-content: center;
    font-size: 1rem; color: var(--gold); flex-shrink: 0;
  }
  [data-theme="dark"] .rr-security-icon { background: rgba(79,110,242,0.2); color: #93c5fd; }
  .rr-security-text { font-size: 0.83rem; color: var(--gray-600); line-height: 1.6; }
  [data-theme="dark"] .rr-security-text { color: #64748b; }
  .rr-security-text strong { color: var(--gray-800); font-weight: 600; display: block; margin-bottom: 2px; }
  [data-theme="dark"] .rr-security-text strong { color: #cbd5e1; }

  @media (max-width: 768px) {
    .rr-profile-hero { flex-direction: column; text-align: center; gap: 16px; padding: 32px 24px; }
    .rr-profile-grid { grid-template-columns: 1fr; }
    .rr-profile { padding: 0 16px; }
    .rr-profile-page { padding: 32px 0 60px; }
  }
</style>

<div class="rr-profile-page">
  <div class="rr-profile">
    <!-- Hero -->
    <div class="rr-profile-hero reveal">
      <div class="rr-profile-avatar">
        <%= currentUser.username ? currentUser.username[0].toUpperCase() : 'U' %>
      </div>
      <div class="rr-profile-hero-info">
        <h1><%= currentUser.username %></h1>
        <p><%= currentUser.email %></p>
        <div class="rr-profile-badge">
          <% if (currentUser.isAdmin) { %>
            <i class="bi bi-shield-fill-check"></i> Administrator
          <% } else { %>
            <i class="bi bi-star-fill"></i> RoomRover Member
          <% } %>
        </div>
      </div>
    </div>

    <div class="rr-profile-grid">
      <!-- Left column -->
      <div style="display:flex;flex-direction:column;gap:20px;">
        <!-- Personal info -->
        <div class="rr-pcard reveal reveal-d1">
          <div class="rr-pcard-title"><i class="bi bi-person-lines-fill"></i> Personal Information</div>
          <div class="rr-detail-row">
            <span class="rr-detail-label">Username</span>
            <span class="rr-detail-value"><%= currentUser.username %></span>
          </div>
          <div class="rr-detail-row">
            <span class="rr-detail-label">Email</span>
            <span class="rr-detail-value"><%= currentUser.email %></span>
          </div>
          <div class="rr-detail-row">
            <span class="rr-detail-label">Account type</span>
            <span class="rr-detail-value">
              <% if (currentUser.isAdmin) { %>
                <span class="badge badge-gold"><i class="bi bi-shield-check"></i> Administrator</span>
              <% } else { %>
                <span class="badge badge-gray">Member</span>
              <% } %>
            </span>
          </div>
          <div class="rr-detail-row">
            <span class="rr-detail-label">Status</span>
            <span class="rr-detail-value">
              <span class="badge badge-green"><i class="bi bi-circle-fill" style="font-size:0.55rem;"></i> Active</span>
            </span>
          </div>
        </div>

        <!-- Activity stats -->
        <div class="rr-pcard reveal reveal-d2">
          <div class="rr-pcard-title"><i class="bi bi-bar-chart-fill"></i> Activity Summary</div>
          <div class="rr-stats-row">
            <div class="rr-stat">
              <div class="rr-stat-num">0</div>
              <div class="rr-stat-label">Reviews</div>
            </div>
            <div class="rr-stat">
              <div class="rr-stat-num">0</div>
              <div class="rr-stat-label">Bookings</div>
            </div>
            <div class="rr-stat">
              <div class="rr-stat-num">0</div>
              <div class="rr-stat-label">Listings</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right column -->
      <div style="display:flex;flex-direction:column;gap:20px;">
        <div class="rr-pcard reveal reveal-d1">
          <div class="rr-pcard-title"><i class="bi bi-lightning-charge-fill"></i> Quick Actions</div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/trips" class="rr-action-btn">
              <i class="bi bi-suitcase2"></i> My Trips
            </a>
            <a href="/listings/new" class="rr-action-btn">
              <i class="bi bi-plus-circle"></i> List a property
            </a>
            <a href="/wishlist" class="rr-action-btn">
              <i class="bi bi-heart"></i> Wishlist
            </a>
            <a href="/listings" class="rr-action-btn">
              <i class="bi bi-compass"></i> Browse listings
            </a>
            <% if (currentUser.isAdmin) { %>
            <a href="/admin" class="rr-action-btn" style="color:var(--gold);border-color:rgba(201,168,76,0.25);">
              <i class="bi bi-speedometer2"></i> Admin Dashboard
            </a>
            <% } %>
            <a href="/logout" class="rr-action-btn danger" style="margin-top:4px;">
              <i class="bi bi-box-arrow-right"></i> Sign out
            </a>
          </div>
        </div>

        <!-- Security info -->
        <div class="rr-security-card reveal reveal-d2">
          <div class="rr-security-icon"><i class="bi bi-shield-check"></i></div>
          <div class="rr-security-text">
            <strong>Account secured</strong>
            Keep your password private. Never share login credentials with anyone.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
