<%- layout("layouts/boilerplate") %>
<style>
  .rr-admin-wrap { max-width: 1280px; margin: 0 auto; padding: 40px 24px 64px; }

  /* ── Header ── */
  .rr-admin-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 32px; flex-wrap: wrap; gap: 12px;
  }
  .rr-admin-header h1 { font-size: 1.75rem; color: var(--navy); margin: 0; }
  .rr-admin-header p { color: var(--gray-500); margin: 4px 0 0; font-size: 0.9rem; }

  /* ── Stat cards ── */
  .rr-stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px; margin-bottom: 36px;
  }
  .rr-stat-card {
    background: var(--white); border: var(--border); border-radius: var(--radius-lg);
    padding: 24px; display: flex; flex-direction: column; gap: 10px;
    transition: var(--transition);
  }
  .rr-stat-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
  .rr-stat-icon {
    width: 48px; height: 48px; border-radius: var(--radius);
    display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
  }
  .rr-stat-icon.navy  { background: rgba(26,35,50,0.08); }
  .rr-stat-icon.gold  { background: rgba(201,168,76,0.12); }
  .rr-stat-icon.green { background: rgba(40,167,69,0.1); }
  .rr-stat-icon.blue  { background: rgba(59,130,246,0.1); }
  .rr-stat-value { font-size: 2rem; font-weight: 800; color: var(--navy); line-height: 1; }
  .rr-stat-label { font-size: 0.82rem; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.4px; }

  /* Dark mode */
  [data-theme="dark"] .rr-admin-wrap { background: #0f1624; }
  [data-theme="dark"] .rr-admin-header h1 { color: #f1f5f9; }
  [data-theme="dark"] .rr-admin-header p { color: #64748b; }
  [data-theme="dark"] .rr-stat-card { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07); }
  [data-theme="dark"] .rr-stat-value { color: #4f6ef2; }
  [data-theme="dark"] .rr-stat-icon.navy  { background: rgba(79,110,242,0.12); }
  [data-theme="dark"] .rr-stat-icon.gold  { background: rgba(201,168,76,0.12); }
  [data-theme="dark"] .rr-stat-icon.green { background: rgba(16,185,129,0.12); }
  [data-theme="dark"] .rr-stat-icon.blue  { background: rgba(59,130,246,0.12); }

  /* ── Section heading ── */
  .rr-section-title {
    font-size: 1.15rem; font-weight: 700; color: var(--navy);
    margin-bottom: 16px; padding-bottom: 12px;
    border-bottom: 2px solid var(--gray-200);
    display: flex; align-items: center; gap: 8px;
  }
  .rr-section-title i { color: var(--gold); }

  /* ── Table ── */
  .rr-table-wrap {
    background: var(--white); border: var(--border); border-radius: var(--radius-lg);
    overflow: hidden; margin-bottom: 36px;
  }
  .rr-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .rr-table thead tr { background: var(--gray-50); }
  .rr-table th {
    padding: 12px 16px; text-align: left;
    font-size: 0.75rem; font-weight: 700; color: var(--gray-500);
    text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;
  }
  .rr-table td { padding: 13px 16px; border-top: 1px solid var(--gray-200); color: var(--gray-800); }
  .rr-table tbody tr:hover { background: var(--gray-50); }
  .rr-table .rr-listing-thumb {
    width: 44px; height: 44px; border-radius: 8px; object-fit: cover;
  }
  .rr-booking-guest { font-weight: 600; color: var(--navy); }
  .rr-booking-listing { color: var(--gray-600); font-size: 0.82rem; }
  .rr-booking-date { color: var(--gray-500); font-size: 0.82rem; }
  .rr-booking-amount { font-weight: 700; color: var(--navy); white-space: nowrap; }
  .rr-nights-chip {
    background: var(--gray-100); color: var(--gray-700);
    font-size: 0.72rem; font-weight: 600; padding: 2px 8px;
    border-radius: 20px; white-space: nowrap;
  }

  /* ── Quick actions ── */
  .rr-quick-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }
  .rr-quick-btn {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 20px 16px; border-radius: var(--radius-lg);
    border: 1.5px solid var(--gray-200); background: var(--white);
    text-decoration: none; color: var(--gray-800); font-size: 0.85rem;
    font-weight: 600; transition: var(--transition); text-align: center;
    font-family: inherit; cursor: pointer;
  }
  .rr-quick-btn i { font-size: 1.5rem; color: var(--navy); }
  .rr-quick-btn:hover { border-color: var(--navy); background: rgba(26,35,50,0.03); transform: translateY(-2px); box-shadow: var(--shadow); }

  /* ── Empty state ── */
  .rr-table-empty { text-align: center; padding: 40px; color: var(--gray-400); }

  /* ── Dark mode ── */
  [data-theme="dark"] .rr-section-title { color: #f1f5f9; border-bottom-color: rgba(255,255,255,0.07); }
  [data-theme="dark"] .rr-table-wrap { background: #111827; border-color: rgba(255,255,255,0.07); }
  [data-theme="dark"] .rr-table thead tr { background: #1a2233; }
  [data-theme="dark"] .rr-table td { border-top-color: rgba(255,255,255,0.06); }
  [data-theme="dark"] .rr-table tbody tr:hover { background: rgba(255,255,255,0.03); }
  [data-theme="dark"] .rr-booking-guest { color: #e2e8f0; }
  [data-theme="dark"] .rr-booking-amount { color: #93c5fd; }
  [data-theme="dark"] .rr-quick-btn {
    background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07); color: #cbd5e1;
  }
  [data-theme="dark"] .rr-quick-btn i { color: #4f6ef2; }
  [data-theme="dark"] .rr-quick-btn:hover { border-color: #4f6ef2; background: rgba(79,110,242,0.08); }
  [data-theme="dark"] .rr-nights-chip { background: rgba(255,255,255,0.08); color: #94a3b8; }

  @media (max-width: 768px) {
    .rr-admin-wrap { padding: 24px 16px 48px; }
    .rr-stat-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .rr-table th:nth-child(n+4), .rr-table td:nth-child(n+4) { display: none; }
  }
  @media (max-width: 480px) {
    .rr-stat-grid { grid-template-columns: 1fr 1fr; }
    .rr-stat-value { font-size: 1.6rem; }
  }
</style>

<div class="rr-admin-wrap">

  <!-- Header -->
  <div class="rr-admin-header">
    <div>
      <h1><i class="bi bi-speedometer2" style="color:var(--gold);margin-right:8px;"></i>Admin Dashboard</h1>
      <p>Overview of your RoomRover platform</p>
    </div>
    <a href="/listings" class="btn btn-outline btn-sm"><i class="bi bi-arrow-left"></i> Back to Listings</a>
  </div>

  <!-- Stat cards -->
  <div class="rr-stat-grid">
    <div class="rr-stat-card reveal reveal-d1">
      <div class="rr-stat-icon navy"><i class="bi bi-houses" style="color:var(--navy);"></i></div>
      <div class="rr-stat-value"><%= totalListings %></div>
      <div class="rr-stat-label">Total Listings</div>
    </div>
    <div class="rr-stat-card reveal reveal-d2">
      <div class="rr-stat-icon gold"><i class="bi bi-calendar-check" style="color:var(--gold);"></i></div>
      <div class="rr-stat-value"><%= totalBookings %></div>
      <div class="rr-stat-label">Total Bookings</div>
    </div>
    <div class="rr-stat-card reveal reveal-d3">
      <div class="rr-stat-icon green"><i class="bi bi-people" style="color:#28a745;"></i></div>
      <div class="rr-stat-value"><%= totalUsers %></div>
      <div class="rr-stat-label">Registered Users</div>
    </div>
    <div class="rr-stat-card reveal reveal-d4">
      <div class="rr-stat-icon blue"><i class="bi bi-currency-rupee" style="color:#3b82f6;"></i></div>
      <div class="rr-stat-value">₹<%= (totalRevenue/1000).toFixed(0) %>k</div>
      <div class="rr-stat-label">Est. Revenue</div>
    </div>
  </div>

  <!-- Recent Bookings -->
  <div class="rr-section-title reveal">
    <i class="bi bi-clock-history"></i> Recent Bookings
  </div>
  <div class="rr-table-wrap reveal">
    <% if (recentBookings.length === 0) { %>
      <div class="rr-table-empty">
        <i class="bi bi-calendar-x" style="font-size:2rem;display:block;margin-bottom:8px;"></i>
        No bookings yet
      </div>
    <% } else { %>
      <table class="rr-table">
        <thead>
          <tr>
            <th>Property</th>
            <th>Guest</th>
            <th>Check-in → Check-out</th>
            <th>Duration</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <% for (let b of recentBookings) { %>
            <%
              const nights = Math.max(1, Math.ceil((new Date(b.endDate) - new Date(b.startDate)) / (1000*60*60*24)));
              const amount = b.listing?.price ? b.listing.price * nights : null;
              const imgSrc = b.listing?.image?.url || b.listing?.image || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=100&q=60';
              const checkin  = new Date(b.startDate).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'});
              const checkout = new Date(b.endDate).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'});
            %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:10px;">
                  <img src="<%= imgSrc %>" alt="" class="rr-listing-thumb" loading="lazy">
                  <div>
                    <div style="font-weight:600;color:var(--navy);font-size:0.85rem;">
                      <%= b.listing?.title || 'Deleted listing' %>
                    </div>
                    <div class="rr-booking-listing"><%= b.listing?.location || '' %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="rr-booking-guest"><i class="bi bi-person" style="margin-right:4px;"></i><%= b.user?.username || 'Unknown' %></div>
                <div class="rr-booking-date"><%= b.guests %> guest<%= b.guests > 1 ? 's' : '' %></div>
              </td>
              <td>
                <div style="font-weight:500;"><%= checkin %></div>
                <div class="rr-booking-date">→ <%= checkout %></div>
              </td>
              <td><span class="rr-nights-chip"><%= nights %> night<%= nights !== 1 ? 's' : '' %></span></td>
              <td>
                <% if (amount) { %>
                  <div class="rr-booking-amount">₹<%= amount.toLocaleString('en-IN') %></div>
                <% } else { %>
                  <div class="rr-booking-date">—</div>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </div>

  <!-- Quick Actions -->
  <div class="rr-section-title reveal">
    <i class="bi bi-lightning-charge"></i> Quick Actions
  </div>
  <div class="rr-quick-grid reveal">
    <a href="/listings" class="rr-quick-btn">
      <i class="bi bi-houses"></i> All Listings
    </a>
    <a href="/listings/new" class="rr-quick-btn">
      <i class="bi bi-plus-circle"></i> Add Listing
    </a>
    <a href="/trips" class="rr-quick-btn">
      <i class="bi bi-suitcase"></i> All Trips
    </a>
  </div>

</div>
