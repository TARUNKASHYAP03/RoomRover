<%- layout("layouts/boilerplate") %>
<style>
  .rr-form-page { max-width: 720px; margin: 0 auto; padding: 40px 24px 80px; }
  .rr-form-header {
    text-align: center; margin-bottom: 36px;
  }
  .rr-form-header h1 { font-size: 1.9rem; color: var(--navy); margin-bottom: 6px; }
  .rr-form-header p { color: var(--gray-600); }
  .rr-form-card {
    background: var(--white); border-radius: var(--radius-lg);
    border: var(--border); padding: 36px; box-shadow: var(--shadow-sm);
  }
  .rr-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .rr-upload-zone {
    border: 2px dashed var(--gray-300); border-radius: var(--radius);
    padding: 36px 20px; text-align: center; cursor: pointer;
    transition: var(--transition); background: var(--gray-50);
  }
  .rr-upload-zone:hover, .rr-upload-zone.drag-over {
    border-color: var(--navy); background: var(--gray-100);
  }
  .rr-upload-zone i { font-size: 2rem; color: var(--gray-400); margin-bottom: 8px; display: block; }
  .rr-upload-zone p { font-size: 0.88rem; color: var(--gray-500); margin: 4px 0; }
  #rr-img-preview { display: none; margin-bottom: 12px; position: relative; }
  #rr-img-preview img {
    width: 100%; height: 180px; object-fit: cover;
    border-radius: var(--radius-sm); border: var(--border);
  }
  #rr-img-preview button {
    position: absolute; top: 8px; right: 8px;
    background: rgba(0,0,0,0.6); color: #fff; border: none;
    border-radius: 50%; width: 28px; height: 28px; cursor: pointer; font-size: 0.9rem;
  }
  .rr-char-counter { font-size: 0.78rem; color: var(--gray-500); float: right; }
  .rr-form-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 28px; padding-top: 24px; border-top: var(--border); }

  /* Dark mode */
  [data-theme="dark"] .rr-form-page { background: #0f1624; }
  [data-theme="dark"] .rr-form-header h1 { color: #f1f5f9; }
  [data-theme="dark"] .rr-form-header p { color: #64748b; }
  [data-theme="dark"] .rr-form-card {
    background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07);
    box-shadow: 0 4px 32px rgba(0,0,0,0.5);
  }
  [data-theme="dark"] .rr-upload-zone {
    border-color: rgba(255,255,255,0.12); background: rgba(255,255,255,0.03);
  }
  [data-theme="dark"] .rr-upload-zone:hover {
    border-color: #4f6ef2; background: rgba(79,110,242,0.06);
  }
  [data-theme="dark"] .rr-upload-zone i { color: #475569; }
  [data-theme="dark"] .rr-upload-zone p { color: #475569; }

  @media (max-width: 560px) {
    .rr-form-card { padding: 20px; }
    .rr-row { grid-template-columns: 1fr; }
    .rr-form-page { padding: 24px 16px 60px; }
  }
</style>

<div class="rr-form-page">
  <div class="rr-form-header">
    <h1>List your property</h1>
    <p>Share your space and start earning with RoomRover</p>
  </div>

  <div class="rr-form-card">
    <form action="/listings" method="POST" enctype="multipart/form-data" id="newListingForm">

      <div class="form-group">
        <label class="form-label">Listing title *</label>
        <input type="text" name="listing[title]" class="form-control"
          placeholder="e.g. Cozy beachfront villa in Goa" required maxlength="80">
      </div>

      <div class="form-group">
        <label class="form-label">
          Description *
          <span class="rr-char-counter"><span id="desc-count">0</span>/500</span>
        </label>
        <textarea name="listing[description]" id="description" class="form-control"
          placeholder="Describe what makes your place special — unique features, nearby attractions, house rules…"
          rows="5" required maxlength="500"></textarea>
      </div>

      <div class="rr-row">
        <div class="form-group">
          <label class="form-label">Price per night (₹) *</label>
          <input type="number" name="listing[price]" class="form-control"
            placeholder="2500" min="0" step="50" required>
        </div>
        <div class="form-group">
          <label class="form-label">Location *</label>
          <input type="text" name="listing[location]" class="form-control"
            placeholder="e.g. Goa" required>
        </div>
      </div>

      <div class="rr-row">
        <div class="form-group">
          <label class="form-label">Country *</label>
          <select name="listing[country]" class="form-control" required>
            <option value="India" selected>India</option>
            <option value="United States">United States</option>
            <option value="Canada">Canada</option>
            <option value="Australia">Australia</option>
            <option value="United Kingdom">United Kingdom</option>
            <option value="Germany">Germany</option>
            <option value="France">France</option>
            <option value="Japan">Japan</option>
            <option value="Brazil">Brazil</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="listing[category]" class="form-control">
            <option value="">Select type</option>
            <option value="Beach">Beach</option>
            <option value="Mountain">Mountain</option>
            <option value="City">City</option>
            <option value="Countryside">Countryside</option>
            <option value="Apartment">Apartment</option>
            <option value="Villa">Villa</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Property photo</label>
        <div class="rr-upload-zone" id="dropZone" onclick="document.getElementById('imageInput').click()">
          <div id="rr-img-preview">
            <img id="preview-img" src="" alt="Preview">
            <button type="button" onclick="event.stopPropagation();clearImage()" title="Remove">×</button>
          </div>
          <div id="upload-placeholder">
            <i class="bi bi-cloud-arrow-up"></i>
            <p><strong>Click to upload</strong> or drag & drop</p>
            <p>JPG, PNG — max 5MB</p>
          </div>
        </div>
        <input type="file" id="imageInput" name="image" accept="image/*" class="d-none">
      </div>

      <div class="rr-form-footer">
        <a href="/listings" class="btn btn-outline">
          <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn btn-gold btn-lg">
          <i class="bi bi-plus-circle"></i> Create listing
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Char counter
  const desc = document.getElementById('description');
  const cnt = document.getElementById('desc-count');
  desc.addEventListener('input', () => { cnt.textContent = desc.value.length; });

  // Image preview
  const imgInput = document.getElementById('imageInput');
  const preview = document.getElementById('rr-img-preview');
  const previewImg = document.getElementById('preview-img');
  const placeholder = document.getElementById('upload-placeholder');

  imgInput.addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { alert('File must be under 5MB'); return; }
    const reader = new FileReader();
    reader.onload = ev => { previewImg.src = ev.target.result; preview.style.display = 'block'; placeholder.style.display = 'none'; };
    reader.readAsDataURL(file);
  });

  function clearImage() {
    imgInput.value = ''; previewImg.src = '';
    preview.style.display = 'none'; placeholder.style.display = 'block';
  }

  // Drag & drop
  const zone = document.getElementById('dropZone');
  ['dragenter','dragover'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.add('drag-over'); }));
  ['dragleave','drop'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.remove('drag-over'); }));
  zone.addEventListener('drop', e => {
    e.preventDefault();
    if (e.dataTransfer.files.length) { imgInput.files = e.dataTransfer.files; imgInput.dispatchEvent(new Event('change')); }
  });
</script>
