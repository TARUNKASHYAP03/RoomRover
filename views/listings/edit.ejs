<%- layout("layouts/boilerplate") %>
<style>
  .rr-form-page { max-width: 720px; margin: 0 auto; padding: 40px 24px 80px; }
  .rr-form-header { text-align: center; margin-bottom: 36px; }
  .rr-form-header h1 { font-size: 1.9rem; color: var(--navy); margin-bottom: 6px; }
  .rr-form-header p { color: var(--gray-600); }
  .rr-form-card {
    background: var(--white); border-radius: var(--radius-lg);
    border: var(--border); padding: 36px; box-shadow: var(--shadow-sm);
  }
  .rr-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .rr-current-img {
    width: 100%; height: 180px; object-fit: cover;
    border-radius: var(--radius-sm); border: var(--border);
    margin-bottom: 12px;
  }
  .rr-char-counter { font-size: 0.78rem; color: var(--gray-500); float: right; }
  .rr-form-footer {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 28px; padding-top: 24px; border-top: var(--border);
  }
  /* Dark mode */
  [data-theme="dark"] .rr-form-page { background: #0f1624; }
  [data-theme="dark"] .rr-form-header h1 { color: #f1f5f9; }
  [data-theme="dark"] .rr-form-header p { color: #64748b; }
  [data-theme="dark"] .rr-form-card {
    background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07);
    box-shadow: 0 4px 32px rgba(0,0,0,0.5);
  }
  [data-theme="dark"] .rr-current-img { border-color: rgba(255,255,255,0.08); }
  @media (max-width: 560px) {
    .rr-form-card { padding: 20px; }
    .rr-row { grid-template-columns: 1fr; }
    .rr-form-page { padding: 24px 16px 60px; }
  }
</style>

<div class="rr-form-page">
  <div style="margin-bottom: 16px;">
    <a href="/listings/<%= listing._id %>" class="btn btn-ghost btn-sm">
      <i class="bi bi-arrow-left"></i> Back to listing
    </a>
  </div>

  <div class="rr-form-header">
    <h1>Edit listing</h1>
    <p>Update your property details</p>
  </div>

  <div class="rr-form-card">
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data" id="editForm">

      <div class="form-group">
        <label class="form-label">Listing title *</label>
        <input type="text" name="listing[title]" class="form-control"
          value="<%= listing.title %>" required maxlength="80">
      </div>

      <div class="form-group">
        <label class="form-label">
          Description *
          <span class="rr-char-counter"><span id="desc-count"><%= listing.description.length %></span>/500</span>
        </label>
        <textarea name="listing[description]" id="description" class="form-control"
          rows="5" required maxlength="500"><%= listing.description %></textarea>
      </div>

      <div class="rr-row">
        <div class="form-group">
          <label class="form-label">Price per night (₹) *</label>
          <input type="number" name="listing[price]" class="form-control"
            value="<%= listing.price %>" min="0" step="50" required>
        </div>
        <div class="form-group">
          <label class="form-label">Location *</label>
          <input type="text" name="listing[location]" class="form-control"
            value="<%= listing.location %>" required>
        </div>
      </div>

      <div class="rr-row">
        <div class="form-group">
          <label class="form-label">Country *</label>
          <input type="text" name="listing[country]" class="form-control"
            value="<%= listing.country %>" required list="countries">
          <datalist id="countries">
            <option value="India"></option>
            <option value="United States"></option>
            <option value="Canada"></option>
            <option value="Australia"></option>
            <option value="United Kingdom"></option>
            <option value="Germany"></option>
            <option value="France"></option>
            <option value="Japan"></option>
            <option value="Brazil"></option>
          </datalist>
        </div>
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="listing[category]" class="form-control">
            <option value="">Select type</option>
            <% ['Beach','Mountain','City','Countryside','Apartment','Villa'].forEach(cat => { %>
              <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <!-- Current image -->
      <div class="form-group">
        <label class="form-label">Property photo</label>
        <% const imgSrc = listing.image?.url || listing.image; %>
        <% if (imgSrc) { %>
          <img src="<%= imgSrc %>" alt="Current image" class="rr-current-img" id="current-img">
          <p style="font-size:0.82rem;color:var(--gray-500);margin-bottom:10px;">Current image — upload a new one to replace</p>
        <% } %>
        <input type="file" name="image" id="imageInput" accept="image/*" class="form-control"
          style="padding: 8px 10px; cursor:pointer;">
        <p class="form-hint">JPG, PNG — max 5MB</p>
      </div>

      <div class="rr-form-footer">
        <a href="/listings/<%= listing._id %>" class="btn btn-outline">
          <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" id="submitBtn" class="btn btn-gold btn-lg">
          <i class="bi bi-check-lg"></i> Save changes
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Char counter
  const desc = document.getElementById('description');
  const cnt = document.getElementById('desc-count');
  desc.addEventListener('input', () => { cnt.textContent = desc.value.length; });

  // Image preview on change
  const imgInput = document.getElementById('imageInput');
  const curImg = document.getElementById('current-img');
  imgInput.addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { alert('File must be under 5MB'); imgInput.value=''; return; }
    if (curImg) {
      const reader = new FileReader();
      reader.onload = ev => { curImg.src = ev.target.result; };
      reader.readAsDataURL(file);
    }
  });

  // Submit feedback
  document.getElementById('editForm').addEventListener('submit', function() {
    const btn = document.getElementById('submitBtn');
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving…';
    btn.disabled = true;
  });
</script>
