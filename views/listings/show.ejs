<%- layout("layouts/boilerplate") %>
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<style>
  .rr-show-page {
    background: var(--off-white); min-height: calc(100vh - 66px); padding-bottom: 80px;
  }
  [data-theme="dark"] .rr-show-page { background: #0f1624; }

  .rr-show { max-width: 1120px; margin: 0 auto; padding: 32px 24px 0; }

  /* ── Hero image ── */
  .rr-show-hero {
    width: 100%; height: 500px; border-radius: 22px;
    overflow: hidden; position: relative; margin-bottom: 36px;
    background: var(--gray-100);
  }
  [data-theme="dark"] .rr-show-hero { background: #1a2233; }
  .rr-show-hero img {
    width: 100%; height: 100%; object-fit: cover;
    cursor: zoom-in; transition: transform 0.45s ease;
  }
  .rr-show-hero img:hover { transform: scale(1.02); }
  .rr-show-hero-badge {
    position: absolute; top: 18px; left: 18px;
    background: rgba(0,0,0,0.6); color: #fff; backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 7px 16px; border-radius: 20px; font-size: 0.82rem; font-weight: 600;
    border: 1px solid rgba(255,255,255,0.15);
  }

  /* ── Layout ── */
  .rr-show-layout {
    display: grid; grid-template-columns: 1fr 360px; gap: 44px; align-items: start;
  }

  /* ── Title block ── */
  .rr-show-title {
    font-size: 2rem; font-weight: 800; color: var(--navy); margin-bottom: 8px; line-height: 1.2;
  }
  [data-theme="dark"] .rr-show-title { color: #f1f5f9; }
  .rr-show-location {
    display: flex; align-items: center; gap: 6px;
    color: var(--gray-600); font-size: 0.95rem; margin-bottom: 22px;
  }
  [data-theme="dark"] .rr-show-location { color: #64748b; }
  .rr-show-location i { color: var(--gold); }

  /* ── Info chips ── */
  .rr-info-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .rr-info-chip {
    display: flex; align-items: center; gap: 7px;
    padding: 9px 15px; border-radius: 12px;
    background: var(--gray-50); border: 1px solid var(--gray-200);
    font-size: 0.875rem; color: var(--gray-700);
    font-weight: 500;
  }
  [data-theme="dark"] .rr-info-chip {
    background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07); color: #cbd5e1;
  }
  .rr-info-chip i { color: var(--gold); }

  /* ── Section ── */
  .rr-section { margin-bottom: 36px; }
  .rr-section-title {
    font-size: 1.05rem; font-weight: 700; color: var(--navy);
    margin-bottom: 14px; padding-bottom: 12px;
    border-bottom: 2px solid var(--gray-200);
    display: flex; align-items: center; gap: 8px;
  }
  [data-theme="dark"] .rr-section-title {
    color: #f1f5f9; border-color: rgba(255,255,255,0.07);
  }
  .rr-section-title i { color: var(--gold); }
  .rr-description { color: var(--gray-700); line-height: 1.8; font-size: 0.97rem; }
  [data-theme="dark"] .rr-description { color: #94a3b8; }

  /* ── Host ── */
  .rr-host {
    display: flex; align-items: center; gap: 16px;
    padding: 18px 20px; background: var(--gray-50); border-radius: 14px;
    border: 1px solid var(--gray-200);
  }
  [data-theme="dark"] .rr-host { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07); }
  .rr-host-avatar {
    width: 54px; height: 54px; border-radius: 50%;
    background: var(--navy); display: flex; align-items: center;
    justify-content: center; font-size: 1.4rem; color: var(--gold); flex-shrink: 0; font-weight: 700;
  }
  [data-theme="dark"] .rr-host-avatar { background: rgba(79,110,242,0.2); color: #93c5fd; }
  .rr-host-name { font-weight: 700; color: var(--navy); margin-bottom: 2px; }
  [data-theme="dark"] .rr-host-name { color: #f1f5f9; }
  .rr-host-since { font-size: 0.82rem; color: var(--gray-500); }
  [data-theme="dark"] .rr-host-since { color: #64748b; }

  /* ── Map ── */
  #rr-map {
    width: 100%; height: 300px; border-radius: 14px;
    border: 1px solid var(--gray-200); overflow: hidden;
  }
  [data-theme="dark"] #rr-map { border-color: rgba(255,255,255,0.07); }

  /* ── Admin actions ── */
  .rr-admin-actions { display: flex; gap: 10px; margin-bottom: 28px; flex-wrap: wrap; }

  /* ── Booking Sidebar ── */
  .rr-booking-card {
    position: sticky; top: 88px;
    background: var(--white); border-radius: 22px;
    border: 1px solid var(--gray-200); box-shadow: 0 8px 40px rgba(0,0,0,0.1); padding: 28px;
  }
  [data-theme="dark"] .rr-booking-card {
    background: rgba(255,255,255,0.04);
    border-color: rgba(79,110,242,0.2);
    box-shadow: 0 8px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(79,110,242,0.1);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .rr-booking-price { margin-bottom: 20px; }
  .rr-booking-price .amount {
    font-size: 2rem; font-weight: 800; color: var(--navy);
  }
  [data-theme="dark"] .rr-booking-price .amount { color: #f1f5f9; }
  .rr-booking-price .per { font-size: 0.9rem; color: var(--gray-500); }
  [data-theme="dark"] .rr-booking-price .per { color: #64748b; }
  .rr-booking-divider { height: 1px; background: var(--gray-200); margin: 18px 0; }
  [data-theme="dark"] .rr-booking-divider { background: rgba(255,255,255,0.07); }
  .date-error { color: #ef4444; font-size: 0.8rem; margin-top: -8px; margin-bottom: 8px; display: none; }

  /* Book now button */
  .rr-book-btn {
    width: 100%; padding: 14px; border: none; border-radius: 14px;
    font-weight: 700; font-size: 1rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--gold); color: #fff; transition: all 0.25s ease; font-family: inherit;
  }
  [data-theme="dark"] .rr-book-btn {
    background: linear-gradient(135deg, #4f6ef2 0%, #8b5cf6 100%);
    box-shadow: 0 4px 20px rgba(79,110,242,0.35);
  }
  .rr-book-btn:hover { transform: translateY(-2px); opacity: 0.92; }
  [data-theme="dark"] .rr-book-btn:hover { box-shadow: 0 8px 28px rgba(79,110,242,0.5); }

  /* ── Reviews ── */
  .rr-review-card {
    background: var(--white); border-radius: 14px;
    border: 1px solid var(--gray-200); padding: 18px 20px; margin-bottom: 14px;
    transition: all 0.2s ease;
  }
  [data-theme="dark"] .rr-review-card {
    background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07);
  }
  .rr-review-card:hover { box-shadow: var(--shadow-sm); }
  [data-theme="dark"] .rr-review-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.4); border-color: rgba(79,110,242,0.2); }
  .rr-review-header {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;
  }
  .rr-reviewer { display: flex; align-items: center; gap: 10px; }
  .rr-reviewer-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--navy); display: flex; align-items: center;
    justify-content: center; color: var(--gold); font-size: 0.9rem; font-weight: 700;
  }
  [data-theme="dark"] .rr-reviewer-avatar { background: rgba(79,110,242,0.2); color: #93c5fd; }
  .rr-reviewer-name { font-weight: 600; color: var(--navy); font-size: 0.95rem; }
  [data-theme="dark"] .rr-reviewer-name { color: #e2e8f0; }
  .rr-reviewer-date { font-size: 0.78rem; color: var(--gray-500); margin-top: 1px; }
  [data-theme="dark"] .rr-reviewer-date { color: #475569; }
  .rr-stars { display: flex; gap: 2px; }
  .rr-star-filled { color: #f59e0b; }
  .rr-star-empty  { color: var(--gray-300); }
  [data-theme="dark"] .rr-star-empty { color: #334155; }
  .rr-review-comment { color: var(--gray-700); font-size: 0.93rem; line-height: 1.65; }
  [data-theme="dark"] .rr-review-comment { color: #94a3b8; }
  .rr-review-actions { display: flex; gap: 8px; margin-top: 10px; justify-content: flex-end; }

  /* ── Review Form ── */
  .rr-review-form-card {
    background: var(--gray-50); border-radius: 14px;
    border: 1px solid var(--gray-200); padding: 22px; margin-bottom: 24px;
  }
  [data-theme="dark"] .rr-review-form-card {
    background: rgba(79,110,242,0.05); border-color: rgba(79,110,242,0.15);
  }
  .rr-review-form-card h4 { font-size: 1rem; margin-bottom: 14px; color: var(--navy); }
  [data-theme="dark"] .rr-review-form-card h4 { color: #f1f5f9; }
  .rr-star-input { display: flex; gap: 6px; margin-bottom: 14px; }
  .rr-star-input .star {
    font-size: 1.7rem; color: var(--gray-300); cursor: pointer; transition: color 0.15s, transform 0.1s;
  }
  [data-theme="dark"] .rr-star-input .star { color: #334155; }
  .rr-star-input .star:hover { transform: scale(1.15); }
  .rr-star-input .star.active, .rr-star-input .star.hovered { color: #f59e0b; }

  /* Login prompt */
  .rr-login-prompt {
    padding: 16px 20px; background: var(--gray-50); border-radius: 12px;
    border: 1px solid var(--gray-200); margin-bottom: 20px;
    font-size: 0.9rem; color: var(--gray-600);
  }
  [data-theme="dark"] .rr-login-prompt {
    background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07); color: #64748b;
  }
  .rr-login-prompt a { color: var(--navy); font-weight: 600; }
  [data-theme="dark"] .rr-login-prompt a { color: #4f6ef2; }

  @media (max-width: 900px) {
    .rr-show-layout { grid-template-columns: 1fr; }
    .rr-booking-card { position: static; }
    .rr-show-hero { height: 300px; }
    .rr-show { padding: 16px 16px 0; }
  }
</style>

<div class="rr-show-page">
  <div class="rr-show">
    <!-- Back -->
    <div style="margin-bottom:20px;">
      <a href="/listings" class="btn btn-ghost btn-sm">
        <i class="bi bi-arrow-left"></i> All listings
      </a>
    </div>

    <!-- Hero Image -->
    <div class="rr-show-hero">
      <% const imgSrc = listing.images && listing.images.length > 0
          ? listing.images[0].url
          : (listing.image?.url || listing.image || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1200&q=80'); %>
      <img src="<%= imgSrc %>" alt="<%= listing.title %>" id="rr-hero-img">
      <% if (listing.category) { %>
        <span class="rr-show-hero-badge"><i class="bi bi-tag"></i> <%= listing.category %></span>
      <% } %>
    </div>

    <!-- Main Layout -->
    <div class="rr-show-layout">
      <!-- Left: Details -->
      <div>
        <!-- Owner Controls -->
        <% if (currentUser && listing.owner && currentUser._id.toString() === listing.owner._id.toString()) { %>
          <div class="rr-admin-actions">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline btn-sm">
              <i class="bi bi-pencil-square"></i> Edit listing
            </a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST"
              onsubmit="return confirm('Delete this listing permanently?');">
              <button type="submit" class="btn btn-danger btn-sm">
                <i class="bi bi-trash3"></i> Delete
              </button>
            </form>
          </div>
        <% } %>

        <!-- Title & Location -->
        <h1 class="rr-show-title"><%= listing.title %></h1>
        <div class="rr-show-location">
          <i class="bi bi-geo-alt-fill"></i>
          <%= listing.location %>, <%= listing.country %>
        </div>

        <!-- Info chips -->
        <div class="rr-info-row">
          <div class="rr-info-chip">
            <i class="bi bi-currency-rupee"></i>
            <strong>₹<%= listing.price.toLocaleString('en-IN') %></strong>&nbsp;/ night
          </div>
          <% if (listing.maxGuests || listing.guests) { %>
            <div class="rr-info-chip">
              <i class="bi bi-people-fill"></i> Up to <%= listing.maxGuests || listing.guests %> guests
            </div>
          <% } %>
          <% if (listing.bedrooms) { %>
            <div class="rr-info-chip"><i class="bi bi-door-closed"></i> <%= listing.bedrooms %> bedroom<%= listing.bedrooms > 1 ? 's' : '' %></div>
          <% } %>
          <% if (listing.bathrooms) { %>
            <div class="rr-info-chip"><i class="bi bi-droplet-fill"></i> <%= listing.bathrooms %> bath<%= listing.bathrooms > 1 ? 's' : '' %></div>
          <% } %>
          <% if (listing.reviews && listing.reviews.length > 0) {
            const avgR = (listing.reviews.reduce((s,r) => s + (r.rating||0), 0) / listing.reviews.length).toFixed(1);
          %>
            <div class="rr-info-chip">
              <i class="bi bi-star-fill" style="color:#f59e0b;"></i>
              <%= avgR %> (<%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %>)
            </div>
          <% } %>
        </div>

        <!-- Description -->
        <div class="rr-section reveal">
          <div class="rr-section-title"><i class="bi bi-chat-text-fill"></i> About this place</div>
          <p class="rr-description"><%= listing.description %></p>
        </div>

        <!-- Host -->
        <div class="rr-section reveal">
          <div class="rr-section-title"><i class="bi bi-person-badge-fill"></i> Your host</div>
          <div class="rr-host">
            <div class="rr-host-avatar">
              <%= (listing.owner && listing.owner.username) ? listing.owner.username[0].toUpperCase() : '?' %>
            </div>
            <div>
              <div class="rr-host-name"><%= listing.owner ? listing.owner.username : 'Unknown' %></div>
              <div class="rr-host-since">Hosting on RoomRover</div>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="rr-section reveal">
          <div class="rr-section-title"><i class="bi bi-map-fill"></i> Location</div>
          <div id="rr-map"></div>
        </div>

        <!-- Reviews -->
        <div class="rr-section reveal">
          <div class="rr-section-title">
            <i class="bi bi-star-fill"></i> Reviews
            <% if (listing.reviews && listing.reviews.length > 0) { %>
              <span style="font-size:0.82rem;font-weight:500;color:var(--gray-500);margin-left:auto;">
                <%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %>
              </span>
            <% } %>
          </div>

          <!-- Review Form -->
          <% if (currentUser) { %>
            <div class="rr-review-form-card">
              <h4>Leave a review</h4>
              <form action="/listings/<%= listing._id %>/reviews" method="POST">
                <div class="rr-star-input">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <span class="star" data-value="<%= i %>">★</span>
                  <% } %>
                  <input type="hidden" name="review[rating]" id="rating-value" required>
                </div>
                <div class="form-group">
                  <textarea name="review[comment]" class="form-control"
                    placeholder="Share your experience…" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">
                  <i class="bi bi-send-fill"></i> Submit review
                </button>
              </form>
            </div>
          <% } else { %>
            <div class="rr-login-prompt">
              <a href="/login">Log in</a> to leave a review.
            </div>
          <% } %>

          <!-- Reviews List -->
          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <% listing.reviews.forEach(function(review) { %>
              <div class="rr-review-card">
                <div class="rr-review-header">
                  <div class="rr-reviewer">
                    <div class="rr-reviewer-avatar">
                      <%= review.author ? review.author.username[0].toUpperCase() : '?' %>
                    </div>
                    <div>
                      <div class="rr-reviewer-name"><%= review.author ? review.author.username : 'Anonymous' %></div>
                      <div class="rr-reviewer-date">
                        <%= new Date(review.createdAt).toLocaleDateString('en-IN', { year:'numeric', month:'short', day:'numeric' }) %>
                      </div>
                    </div>
                  </div>
                  <div class="rr-stars">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <span class="<%= i <= review.rating ? 'rr-star-filled' : 'rr-star-empty' %>">★</span>
                    <% } %>
                  </div>
                </div>
                <p class="rr-review-comment"><%= review.comment %></p>
                <% if (currentUser && review.author && (
                  currentUser._id.toString() === review.author._id.toString() ||
                  (listing.owner && currentUser._id.toString() === listing.owner._id.toString())
                )) { %>
                  <div class="rr-review-actions">
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                      method="POST" onsubmit="return confirm('Delete this review?');">
                      <button type="submit" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash3"></i> Delete
                      </button>
                    </form>
                  </div>
                <% } %>
              </div>
            <% }); %>
          <% } else { %>
            <div style="text-align:center;padding:36px;color:var(--gray-500);">
              <i class="bi bi-chat-square" style="font-size:2.2rem;opacity:0.3;"></i>
              <p style="margin-top:10px;font-size:0.9rem;">No reviews yet. Be the first!</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right: Booking Sidebar -->
      <div>
        <div class="rr-booking-card">
          <div class="rr-booking-price">
            <span class="amount">₹<%= listing.price.toLocaleString('en-IN') %></span>
            <span class="per"> / night</span>
          </div>

          <% if (currentUser) { %>
            <form action="/listings/<%= listing._id %>/book" method="POST" id="bookingForm">
              <div class="form-group">
                <label class="form-label">Check-in</label>
                <input type="date" name="startDate" id="startDate" class="form-control" required
                  min="<%= new Date().toISOString().split('T')[0] %>">
              </div>
              <div class="form-group">
                <label class="form-label">Check-out</label>
                <input type="date" name="endDate" id="endDate" class="form-control" required
                  min="<%= new Date().toISOString().split('T')[0] %>">
                <div id="dateError" class="date-error">Check-out must be after check-in</div>
              </div>
              <div class="form-group">
                <label class="form-label">Guests</label>
                <select name="guests" id="guests" class="form-control" required>
                  <% const maxG = (listing.maxGuests && listing.maxGuests > 0) ? listing.maxGuests : 10;
                     for (let i = 1; i <= maxG; i++) { %>
                    <option value="<%= i %>"><%= i %> Guest<%= i > 1 ? 's' : '' %></option>
                  <% } %>
                </select>
              </div>
              <div class="rr-booking-divider"></div>
              <button type="submit" class="rr-book-btn">
                <i class="bi bi-calendar-check-fill"></i> Book now
              </button>
            </form>
          <% } else { %>
            <a href="/login" class="rr-book-btn" style="text-decoration:none;">
              <i class="bi bi-box-arrow-in-right"></i> Log in to book
            </a>
            <p style="text-align:center;font-size:0.82rem;color:var(--gray-500);margin-top:12px;">
              Don't have an account? <a href="/signup" style="color:var(--navy);font-weight:600;">Sign up</a>
            </p>
          <% } %>

          <div class="rr-booking-divider"></div>
          <div style="font-size:0.8rem;color:var(--gray-500);text-align:center;display:flex;align-items:center;justify-content:center;gap:6px;">
            <i class="bi bi-shield-check" style="color:#10b981;"></i>
            Secure booking · No charge yet
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Image zoom modal -->
<div id="rr-img-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.94);z-index:9999;align-items:center;justify-content:center;cursor:zoom-out;"
  onclick="this.style.display='none'">
  <img id="rr-modal-img" src="" style="max-width:92%;max-height:92%;border-radius:10px;object-fit:contain;">
</div>

<script>
  // Star rating
  const stars = document.querySelectorAll('.rr-star-input .star');
  const ratingInput = document.getElementById('rating-value');
  let sel = 0;
  stars.forEach((s, i) => {
    s.addEventListener('mouseenter', () => stars.forEach((x,j) => x.classList.toggle('hovered', j <= i)));
    s.addEventListener('mouseleave', () => stars.forEach(x => x.classList.remove('hovered')));
    s.addEventListener('click', () => {
      sel = i + 1; ratingInput.value = sel;
      stars.forEach((x, j) => x.classList.toggle('active', j < sel));
    });
  });

  // Booking validation
  const startD = document.getElementById('startDate');
  const endD   = document.getElementById('endDate');
  const dateErr = document.getElementById('dateError');
  const bookForm = document.getElementById('bookingForm');
  if (startD) startD.addEventListener('change', () => { if (endD) endD.min = startD.value; });
  if (bookForm) bookForm.addEventListener('submit', e => {
    if (startD.value && endD.value && new Date(endD.value) <= new Date(startD.value)) {
      dateErr.style.display = 'block'; e.preventDefault();
    } else if (dateErr) dateErr.style.display = 'none';
  });

  // Image zoom
  const heroImg = document.getElementById('rr-hero-img');
  const modal   = document.getElementById('rr-img-modal');
  const modalImg = document.getElementById('rr-modal-img');
  if (heroImg && modal) {
    heroImg.addEventListener('click', () => { modalImg.src = heroImg.src; modal.style.display = 'flex'; });
  }

  // Map
  const mapEl = document.getElementById('rr-map');
  if (mapEl) {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const map = L.map('rr-map').setView([20.5937, 78.9629], 4);
    const tileUrl = isDark
      ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
      : 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
    L.tileLayer(tileUrl, { attribution: '© OpenStreetMap contributors' }).addTo(map);
    const loc = `<%= listing.location %>, <%= listing.country %>`;
    if (loc.trim() && loc !== ', ') {
      fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(loc)}`)
        .then(r => r.json())
        .then(d => {
          if (d && d.length) {
            const lat = parseFloat(d[0].lat), lon = parseFloat(d[0].lon);
            map.setView([lat, lon], 13);
            L.marker([lat, lon]).addTo(map)
              .bindPopup(`<b><%= listing.title %></b><br><%= listing.location %>`)
              .openPopup();
          }
        }).catch(() => {});
    }
  }
</script>
