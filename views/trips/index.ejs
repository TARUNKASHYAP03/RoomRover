<%- layout("layouts/boilerplate") %>
<style>
  .rr-trips-page {
    min-height: calc(100vh - 66px);
    background: var(--off-white);
    padding: 48px 0 80px;
  }
  [data-theme="dark"] .rr-trips-page { background: #0f1624; }

  .rr-trips { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  .rr-trips-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 36px; flex-wrap: wrap; gap: 14px;
  }
  .rr-trips-header h1 { font-size: 2.1rem; font-weight: 800; color: var(--navy); margin: 0; line-height: 1.1; }
  [data-theme="dark"] .rr-trips-header h1 { color: #f1f5f9; }
  .rr-trips-header p { color: var(--gray-500); margin: 6px 0 0; font-size: 0.9rem; }
  [data-theme="dark"] .rr-trips-header p { color: #64748b; }

  .rr-trips-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  /* ── Trip Card ── */
  .rr-trip-card {
    background: var(--white); border-radius: 20px;
    border: 1px solid var(--gray-200); overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: all 0.3s ease;
    display: flex; flex-direction: column;
  }
  [data-theme="dark"] .rr-trip-card {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.07);
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
  }
  .rr-trip-card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    transform: translateY(-4px);
  }
  [data-theme="dark"] .rr-trip-card:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.6);
    border-color: rgba(79,110,242,0.25);
  }

  .rr-trip-img-wrap { position: relative; height: 210px; overflow: hidden; background: var(--gray-100); }
  [data-theme="dark"] .rr-trip-img-wrap { background: #1a2233; }
  .rr-trip-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.45s ease; }
  .rr-trip-card:hover .rr-trip-img { transform: scale(1.06); }

  /* Status badges */
  .rr-trip-status {
    position: absolute; top: 14px; right: 14px;
    padding: 5px 13px; border-radius: 20px;
    font-size: 0.74rem; font-weight: 700;
    letter-spacing: 0.4px; display: flex; align-items: center; gap: 5px;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .status-upcoming {
    background: rgba(16,185,129,0.18); color: #d1fae5;
    border: 1px solid rgba(16,185,129,0.4);
    box-shadow: 0 0 16px rgba(16,185,129,0.25);
  }
  .status-completed {
    background: rgba(59,130,246,0.18); color: #bfdbfe;
    border: 1px solid rgba(59,130,246,0.4);
    box-shadow: 0 0 16px rgba(59,130,246,0.2);
  }
  .status-past {
    background: rgba(100,116,139,0.18); color: #cbd5e1;
    border: 1px solid rgba(100,116,139,0.3);
  }

  /* Night chip */
  .rr-nights-chip {
    position: absolute; bottom: 14px; left: 14px;
    background: rgba(0,0,0,0.7); color: #fff;
    padding: 4px 10px; border-radius: 10px;
    font-size: 0.72rem; font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .rr-trip-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }

  .rr-trip-title {
    font-size: 1.05rem; font-weight: 700; color: var(--navy); line-height: 1.35;
  }
  [data-theme="dark"] .rr-trip-title { color: #f1f5f9; }

  .rr-trip-meta {
    display: flex; flex-direction: column; gap: 6px;
    font-size: 0.875rem; color: var(--gray-600);
  }
  [data-theme="dark"] .rr-trip-meta { color: #64748b; }
  .rr-trip-meta span { display: flex; align-items: center; gap: 8px; }
  .rr-trip-meta i { color: var(--gold); width: 14px; flex-shrink: 0; }

  /* Price tag */
  .rr-trip-price {
    display: inline-flex; align-items: center; gap: 4px;
    background: var(--gray-50); border: 1px solid var(--gray-200);
    border-radius: 8px; padding: 5px 10px;
    font-size: 0.82rem; font-weight: 700; color: var(--navy);
    align-self: flex-start;
  }
  [data-theme="dark"] .rr-trip-price {
    background: rgba(79,110,242,0.08); border-color: rgba(79,110,242,0.2); color: #93c5fd;
  }

  .rr-trip-footer {
    padding: 14px 22px; border-top: 1px solid var(--gray-200);
    display: flex; gap: 10px;
  }
  [data-theme="dark"] .rr-trip-footer { border-color: rgba(255,255,255,0.06); }

  /* Buttons in footer */
  .rr-trip-btn {
    flex: 1; padding: 9px 14px; border-radius: 10px;
    font-size: 0.85rem; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    border: 1.5px solid var(--gray-300); background: var(--white); color: var(--gray-800);
    text-decoration: none; font-family: inherit; transition: all 0.2s ease;
  }
  [data-theme="dark"] .rr-trip-btn {
    border-color: rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); color: #cbd5e1;
  }
  .rr-trip-btn:hover { border-color: var(--navy); color: var(--navy); background: var(--gray-50); }
  [data-theme="dark"] .rr-trip-btn:hover { border-color: #4f6ef2; color: #93c5fd; background: rgba(79,110,242,0.1); }
  .rr-trip-btn-cancel {
    border-color: rgba(220,53,69,0.25); color: #dc3545;
    background: rgba(220,53,69,0.05);
  }
  [data-theme="dark"] .rr-trip-btn-cancel {
    border-color: rgba(220,53,69,0.2); color: #fca5a5; background: rgba(220,53,69,0.06);
  }
  .rr-trip-btn-cancel:hover { background: rgba(220,53,69,0.1); border-color: #dc3545; color: #dc3545; }
  [data-theme="dark"] .rr-trip-btn-cancel:hover { background: rgba(220,53,69,0.15); }

  /* ── Empty state ── */
  .rr-trips-empty {
    text-align: center; padding: 100px 24px;
    display: flex; flex-direction: column; align-items: center; gap: 16px;
  }
  .rr-trips-empty-icon {
    width: 88px; height: 88px; border-radius: 50%;
    background: var(--gray-100); display: flex; align-items: center;
    justify-content: center; font-size: 2.2rem; color: var(--gray-400);
  }
  [data-theme="dark"] .rr-trips-empty-icon {
    background: rgba(255,255,255,0.05); color: #475569;
  }
  .rr-trips-empty h2 { font-size: 1.5rem; font-weight: 700; color: var(--navy); margin: 0; }
  [data-theme="dark"] .rr-trips-empty h2 { color: #f1f5f9; }
  .rr-trips-empty p { color: var(--gray-500); max-width: 380px; margin: 0; }
  [data-theme="dark"] .rr-trips-empty p { color: #64748b; }

  /* ── Toast ── */
  .rr-notif {
    position: fixed; bottom: 32px; left: 50%; transform: translateX(-50%) translateY(20px);
    padding: 13px 22px; border-radius: 12px; color: #fff; font-weight: 600;
    font-size: 0.9rem; display: flex; align-items: center; gap: 9px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.25); opacity: 0; transition: all 0.3s ease;
    z-index: 9997; pointer-events: none;
  }
  .rr-notif.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .rr-notif.success { background: #10b981; }
  .rr-notif.error   { background: #ef4444; }

  @media (max-width: 768px) {
    .rr-trips-page { padding: 28px 0 60px; }
    .rr-trips { padding: 0 16px; }
    .rr-trips-grid { grid-template-columns: 1fr; }
    .rr-trips-header h1 { font-size: 1.7rem; }
  }
</style>

<div class="rr-trips-page">
  <div class="rr-trips">
    <div class="rr-trips-header">
      <div>
        <h1>My Trips</h1>
        <p><%= bookings.length %> booking<%= bookings.length !== 1 ? 's' : '' %></p>
      </div>
      <a href="/listings" class="btn btn-outline btn-sm">
        <i class="bi bi-search"></i> Find more places
      </a>
    </div>

    <% if (bookings.length === 0) { %>
      <div class="rr-trips-empty reveal">
        <div class="rr-trips-empty-icon"><i class="bi bi-suitcase2"></i></div>
        <h2>No trips yet</h2>
        <p>Your travel story is waiting to be written. Discover amazing places and create unforgettable memories.</p>
        <a href="/listings" class="btn btn-primary" style="margin-top:8px;">
          <i class="bi bi-compass"></i> Explore destinations
        </a>
      </div>
    <% } else { %>
      <div class="rr-trips-grid">
        <% bookings.forEach(function(booking) { %>
          <% if (booking.listing) { %>
            <%
              const now = new Date();
              const start = new Date(booking.startDate);
              const end = new Date(booking.endDate);
              let statusClass, statusLabel, statusIcon;
              if (booking.cancelled) {
                statusClass='status-past'; statusLabel='Cancelled'; statusIcon='bi-x-circle-fill';
              } else if (now > end) {
                statusClass='status-completed'; statusLabel='Completed'; statusIcon='bi-check-circle-fill';
              } else {
                statusClass='status-upcoming'; statusLabel='Upcoming'; statusIcon='bi-calendar-check-fill';
              }
              const nights = Math.ceil((end - start) / (1000*60*60*24));
              const total = (booking.listing.price || 0) * nights;
            %>
            <div class="rr-trip-card reveal" id="trip-<%= booking._id %>">
              <div class="rr-trip-img-wrap">
                <img class="rr-trip-img"
                  src="<%= booking.listing.image?.url || booking.listing.image || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=600&q=80' %>"
                  alt="<%= booking.listing.title %>" loading="lazy">
                <span class="rr-trip-status <%= statusClass %>">
                  <i class="bi <%= statusIcon %>"></i> <%= statusLabel %>
                </span>
                <span class="rr-nights-chip"><%= nights %> night<%= nights !== 1 ? 's' : '' %></span>
              </div>

              <div class="rr-trip-body">
                <div class="rr-trip-title"><%= booking.listing.title %></div>
                <div class="rr-trip-meta">
                  <span><i class="bi bi-geo-alt-fill"></i> <%= booking.listing.location %></span>
                  <span>
                    <i class="bi bi-calendar3"></i>
                    <%= start.toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %>
                    → <%= end.toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %>
                  </span>
                  <span><i class="bi bi-people-fill"></i> <%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %></span>
                </div>
                <% if (total > 0) { %>
                  <div class="rr-trip-price">
                    <i class="bi bi-currency-rupee"></i>
                    ₹<%= total.toLocaleString('en-IN') %> total
                  </div>
                <% } %>
              </div>

              <div class="rr-trip-footer">
                <a href="/listings/<%= booking.listing._id %>" class="rr-trip-btn">
                  <i class="bi bi-eye"></i> View listing
                </a>
                <% if (!booking.cancelled && now < end) { %>
                  <button class="rr-trip-btn rr-trip-btn-cancel"
                    onclick="cancelBooking('<%= booking._id %>', this)">
                    <i class="bi bi-x-lg"></i> Cancel
                  </button>
                <% } %>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<div class="rr-notif" id="rr-notif"></div>

<script>
  function cancelBooking(id, btn) {
    if (!confirm('Cancel this booking? This cannot be undone.')) return;
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Cancelling…';
    btn.disabled = true;
    fetch(`/bookings/${id}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } })
      .then(res => {
        if (res.ok) {
          const card = document.getElementById('trip-' + id);
          card.style.transition = 'all 0.4s cubic-bezier(0.4,0,0.2,1)';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.92) translateY(-8px)';
          setTimeout(() => {
            card.remove();
            showNotif('Booking cancelled successfully', 'success');
            if (!document.querySelector('.rr-trip-card')) location.reload();
          }, 400);
        } else throw new Error('Failed');
      })
      .catch(() => { btn.innerHTML = orig; btn.disabled = false; showNotif('Failed to cancel booking', 'error'); });
  }

  function showNotif(msg, type) {
    const el = document.getElementById('rr-notif');
    el.innerHTML = `<i class="bi bi-${type==='success'?'check-circle':'exclamation-circle'}-fill"></i> ${msg}`;
    el.className = 'rr-notif ' + type;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 3500);
  }
</script>
