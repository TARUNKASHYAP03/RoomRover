<%- layout('/layouts/boilerplate') %>
<style>
/* ── Split-screen Auth Layout ── */
.rr-auth-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: calc(100vh - 66px);
}

/* ── LEFT PANEL ── */
.rr-auth-left {
  position: relative; overflow: hidden;
  background: #06090f;
  display: flex; flex-direction: column;
  padding: 48px 52px;
}

/* Animated orbs */
.rr-auth-orbs { position: absolute; inset: 0; pointer-events: none; }
.rr-auth-orb {
  position: absolute; border-radius: 50%; filter: blur(80px);
}
.rr-auth-orb-1 { width: 420px; height: 420px; background: rgba(79,110,242,0.25); top: -100px; left: -100px; animation: rr-orb-drift 12s ease-in-out infinite; }
.rr-auth-orb-2 { width: 320px; height: 320px; background: rgba(139,92,246,0.2); bottom: -60px; right: -60px; animation: rr-orb-drift 9s ease-in-out infinite reverse; }
.rr-auth-orb-3 { width: 200px; height: 200px; background: rgba(34,211,238,0.12); top: 45%; right: 10%; animation: rr-orb-drift 11s ease-in-out infinite; animation-delay: -5s; }
@keyframes rr-orb-drift {
  0%,100% { transform: translate(0,0) scale(1); }
  33%      { transform: translate(24px,-18px) scale(1.07); }
  66%      { transform: translate(-16px,12px) scale(0.93); }
}

/* Grid texture */
.rr-auth-left::before {
  content: '';
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 56px 56px;
}

.rr-auth-left-inner {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; height: 100%;
}

/* Logo */
.rr-auth-logo-link {
  font-size: 1.5rem; font-weight: 800; letter-spacing: -0.5px;
  color: #fff; text-decoration: none; display: inline-block;
  margin-bottom: auto;
}
.rr-auth-logo-link span { color: #c9a84c; }

/* Main left content */
.rr-auth-left-body {
  flex: 1; display: flex; flex-direction: column; justify-content: center;
  padding: 48px 0;
}

.rr-auth-left-tag {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(79,110,242,0.15);
  border: 1px solid rgba(79,110,242,0.3);
  color: #93b4ff; font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.9px; text-transform: uppercase;
  padding: 6px 14px; border-radius: 30px; margin-bottom: 24px;
  width: fit-content;
}
.rr-auth-left-tag-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: #4f6ef2; box-shadow: 0 0 6px rgba(79,110,242,0.9);
  animation: rr-blink 2s ease-in-out infinite;
}
@keyframes rr-blink { 0%,100%{opacity:1;} 50%{opacity:0.25;} }

.rr-auth-left-h {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 2.4rem; font-weight: 700; color: #f8fafc;
  line-height: 1.18; margin-bottom: 16px;
}
.rr-auth-left-h span {
  background: linear-gradient(135deg,#4f6ef2,#8b5cf6,#22d3ee);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}

.rr-auth-left-sub {
  color: rgba(248,250,252,0.52); font-size: 0.95rem; line-height: 1.75;
  max-width: 340px; margin-bottom: 36px;
}

/* Feature bullets */
.rr-auth-features { display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px; }
.rr-auth-feat {
  display: flex; align-items: center; gap: 14px;
  font-size: 0.9rem; color: rgba(248,250,252,0.75);
}
.rr-auth-feat-icon {
  width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
}
.rr-auth-feat-icon.blue   { background: rgba(79,110,242,0.18);  color: #93b4ff; }
.rr-auth-feat-icon.purple { background: rgba(139,92,246,0.18);  color: #c4b5fd; }
.rr-auth-feat-icon.green  { background: rgba(16,185,129,0.18);  color: #6ee7b7; }

/* Testimonial card */
.rr-auth-testimonial {
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px; padding: 18px 20px;
  backdrop-filter: blur(10px);
}
.rr-auth-testimonial p {
  color: rgba(248,250,252,0.7); font-size: 0.875rem; line-height: 1.65;
  margin-bottom: 14px; font-style: italic;
}
.rr-auth-testimonial-user {
  display: flex; align-items: center; gap: 10px;
}
.rr-auth-testimonial-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: linear-gradient(135deg, #4f6ef2, #8b5cf6);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.85rem; font-weight: 700; color: #fff;
}
.rr-auth-testimonial-name { font-size: 0.82rem; color: #f8fafc; font-weight: 600; }
.rr-auth-testimonial-loc  { font-size: 0.75rem; color: rgba(248,250,252,0.45); }
.rr-auth-stars { color: #f59e0b; font-size: 0.75rem; margin-top: 1px; }

/* ── RIGHT PANEL ── */
.rr-auth-right {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 48px 40px;
  background: var(--off-white);
  overflow-y: auto;
}
[data-theme="dark"] .rr-auth-right { background: #0f1624; }

.rr-auth-form-wrap {
  width: 100%; max-width: 400px;
}

.rr-auth-heading { margin-bottom: 32px; }
.rr-auth-heading h1 {
  font-size: 1.8rem; font-weight: 800; color: var(--navy); margin: 0 0 6px;
  line-height: 1.15;
}
[data-theme="dark"] .rr-auth-heading h1 { color: #f1f5f9; }
.rr-auth-heading p { color: var(--gray-500); font-size: 0.9rem; margin: 0; }
[data-theme="dark"] .rr-auth-heading p { color: #64748b; }

/* Form card */
.rr-auth-card {
  background: var(--white); border-radius: 20px;
  border: 1px solid var(--gray-200);
  box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  padding: 32px 28px;
}
[data-theme="dark"] .rr-auth-card {
  background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.07);
  box-shadow: 0 4px 32px rgba(0,0,0,0.5); backdrop-filter: blur(16px);
}

.form-label {
  display: block; font-size: 0.78rem; font-weight: 700;
  color: var(--gray-600); margin-bottom: 6px;
  text-transform: uppercase; letter-spacing: 0.7px;
}
[data-theme="dark"] .form-label { color: #64748b; }

.rr-input-wrap { position: relative; }
.rr-input-wrap .rr-fi {
  position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
  color: var(--gray-400); font-size: 0.95rem; pointer-events: none; z-index: 1;
}
[data-theme="dark"] .rr-input-wrap .rr-fi { color: #4f6ef2; }
.rr-input-wrap .form-control { padding-left: 38px; }
.rr-input-wrap .rr-eye-btn {
  position: absolute; right: 11px; top: 50%; transform: translateY(-50%);
  background: none; border: none; cursor: pointer;
  color: var(--gray-400); font-size: 0.9rem; padding: 4px;
}
.rr-input-wrap .rr-eye-btn:hover { color: var(--navy); }
[data-theme="dark"] .rr-input-wrap .rr-eye-btn:hover { color: #4f6ef2; }

/* Submit button */
.rr-auth-btn {
  width: 100%; padding: 13px; border: none; border-radius: 12px;
  font-weight: 700; font-size: 0.975rem; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  background: var(--navy); color: #fff;
  transition: all 0.22s ease; font-family: inherit; margin-top: 22px;
}
[data-theme="dark"] .rr-auth-btn {
  background: linear-gradient(135deg, #4f6ef2 0%, #8b5cf6 100%);
  box-shadow: 0 4px 20px rgba(79,110,242,0.35);
}
.rr-auth-btn:hover { transform: translateY(-2px); opacity: 0.91; }
[data-theme="dark"] .rr-auth-btn:hover { box-shadow: 0 8px 28px rgba(79,110,242,0.5); }

.rr-auth-sep {
  display: flex; align-items: center; gap: 12px;
  margin: 20px 0; color: var(--gray-400); font-size: 0.8rem;
}
[data-theme="dark"] .rr-auth-sep { color: #334155; }
.rr-auth-sep::before, .rr-auth-sep::after {
  content: ''; flex: 1; height: 1px; background: var(--gray-200);
}
[data-theme="dark"] .rr-auth-sep::before,
[data-theme="dark"] .rr-auth-sep::after { background: rgba(255,255,255,0.07); }

.rr-auth-switch {
  text-align: center; font-size: 0.875rem; color: var(--gray-600);
}
[data-theme="dark"] .rr-auth-switch { color: #64748b; }
.rr-auth-switch a { color: var(--navy); font-weight: 700; }
[data-theme="dark"] .rr-auth-switch a { color: #4f6ef2; }
.rr-auth-switch a:hover { color: var(--gold); }

/* Trust strip below form */
.rr-auth-trust {
  display: flex; align-items: center; justify-content: center; gap: 18px;
  margin-top: 22px; font-size: 0.75rem; color: var(--gray-500);
}
[data-theme="dark"] .rr-auth-trust { color: #475569; }
.rr-auth-trust span { display: flex; align-items: center; gap: 5px; }

/* Mobile: single column */
@media (max-width: 820px) {
  .rr-auth-wrap { grid-template-columns: 1fr; }
  .rr-auth-left { display: none; }
  .rr-auth-right { padding: 40px 20px; min-height: calc(100vh - 66px); }
}
</style>

<div class="rr-auth-wrap">
  <!-- ── LEFT PANEL ── -->
  <div class="rr-auth-left" aria-hidden="true">
    <div class="rr-auth-orbs">
      <div class="rr-auth-orb rr-auth-orb-1"></div>
      <div class="rr-auth-orb rr-auth-orb-2"></div>
      <div class="rr-auth-orb rr-auth-orb-3"></div>
    </div>
    <div class="rr-auth-left-inner">
      <a href="/" class="rr-auth-logo-link">Room<span>Rover</span></a>

      <div class="rr-auth-left-body">
        <div class="rr-auth-left-tag">
          <span class="rr-auth-left-tag-dot"></span> Trusted by 10,000+ travelers
        </div>
        <h2 class="rr-auth-left-h">
          Your next <span>perfect stay</span><br>is one click away
        </h2>
        <p class="rr-auth-left-sub">
          Sign in to discover handpicked properties across India — from beachside villas to Himalayan cabins.
        </p>

        <div class="rr-auth-features">
          <div class="rr-auth-feat">
            <div class="rr-auth-feat-icon blue"><i class="bi bi-shield-check-fill"></i></div>
            <div>Secure payments, verified properties</div>
          </div>
          <div class="rr-auth-feat">
            <div class="rr-auth-feat-icon purple"><i class="bi bi-lightning-charge-fill"></i></div>
            <div>Instant booking, no hidden fees</div>
          </div>
          <div class="rr-auth-feat">
            <div class="rr-auth-feat-icon green"><i class="bi bi-headset"></i></div>
            <div>24/7 support throughout your stay</div>
          </div>
        </div>

        <div class="rr-auth-testimonial">
          <p>"RoomRover made our Goa trip unforgettable. Found the most amazing beachfront villa in minutes!"</p>
          <div class="rr-auth-testimonial-user">
            <div class="rr-auth-testimonial-avatar">P</div>
            <div>
              <div class="rr-auth-testimonial-name">Priya Sharma</div>
              <div class="rr-auth-testimonial-loc">Mumbai, India</div>
            </div>
            <div class="rr-auth-stars" style="margin-left:auto;">★★★★★</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── RIGHT PANEL ── -->
  <div class="rr-auth-right">
    <div class="rr-auth-form-wrap">
      <div class="rr-auth-heading">
        <h1>Welcome back</h1>
        <p>Sign in to continue your journey</p>
      </div>

      <div class="rr-auth-card">
        <% if (error) { %>
          <div class="alert alert-danger" style="margin-bottom:18px;">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> <%= error %>
          </div>
        <% } %>
        <% if (success) { %>
          <div class="alert alert-success" style="margin-bottom:18px;">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i> <%= success %>
          </div>
        <% } %>

        <form action="/login" method="POST" novalidate>
          <div class="form-group">
            <label class="form-label" for="login-username">Username</label>
            <div class="rr-input-wrap">
              <i class="bi bi-person rr-fi" aria-hidden="true"></i>
              <input id="login-username" type="text" name="username" class="form-control"
                placeholder="Enter your username" required autocomplete="username">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="login-password">Password</label>
            <div class="rr-input-wrap">
              <i class="bi bi-lock rr-fi" aria-hidden="true"></i>
              <input id="login-password" type="password" name="password" class="form-control"
                placeholder="Enter your password" required autocomplete="current-password">
              <button type="button" class="rr-eye-btn" onclick="togglePwd('login-password','eyeIcon')"
                tabindex="-1" aria-label="Toggle password visibility">
                <i class="bi bi-eye" id="eyeIcon" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="rr-auth-btn">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in
          </button>
        </form>
      </div>

      <div class="rr-auth-sep">or</div>
      <div class="rr-auth-switch">
        Don't have an account? <a href="/signup">Create one — it's free</a>
      </div>

      <div class="rr-auth-trust">
        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Secure</span>
        <span><i class="bi bi-lock" aria-hidden="true"></i> Encrypted</span>
        <span><i class="bi bi-star-fill" style="color:#f59e0b;" aria-hidden="true"></i> 4.9 rating</span>
      </div>
    </div>
  </div>
</div>

<script>
  function togglePwd(inputId, iconId) {
    const p = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (p.type === 'password') { p.type = 'text'; icon.className = 'bi bi-eye-slash'; }
    else { p.type = 'password'; icon.className = 'bi bi-eye'; }
  }
</script>
